{
  "name": "@kayiwarahim/relworx",
  "version": "0.1.0",
  "description": "A TypeScript-first Node.js SDK for the Relworx mobile money API.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/kayiwarahim/relworx-node.git" },
  "homepage": "https://github.com/kayiwarahim/relworx-node#readme",
  "bugs": { "url": "https://github.com/kayiwarahim/relworx-node/issues" },
  "keywords": ["relworx", "mobile-money", "payments", "uganda", "collections", "disbursements"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}